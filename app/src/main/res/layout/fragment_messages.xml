<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Отправить комплимент 💜"
        android:textSize="22sp"
        android:textStyle="bold"
        android:layout_marginBottom="24dp" />

    <!-- Кнопка: Случайный комплимент из БД -->
    <Button
        android:id="@+id/btnRandomCompliment"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Случайный комплимент"
        android:layout_marginBottom="16dp" />

    <!-- Поле для ввода своего текста -->
    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:hint="Или напишите свой текст">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/editTextCustomMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minLines="3"
            android:gravity="top" />

    </com.google.android.material.textfield.TextInputLayout>

    <!-- Кнопка отправки -->
    <Button
        android:id="@+id/btnSend"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Отправить через..."
        android:backgroundTint="@color/purple_500" />

</LinearLayout>